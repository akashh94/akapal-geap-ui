# Office environment — self-contained config for the office deployment.
# Sourced by build.sh and deploy.sh. Every variable
# here is also present in deploy.personal.env (with different values), so
# picking which file you source is what picks which environment you deploy to.
#
# All values use "${VAR:-default}" so you can still override per-run:
#   PROJECT_ID=my-project ./deploy.sh

# --- GCP project / region ---------------------------------------------------
export PROJECT_ID="${PROJECT_ID:-labs-gcp-msls-16495-1782829337}"
export REGION="${REGION:-us-east1}"

# --- UI image / service -----------------------------------------------------
# Artifact Registry repo + Cloud Run service name for the office deployment.
export ARTIFACT_REGISTRY="${ARTIFACT_REGISTRY:-akapal-geap-ui}"
export SERVICE_NAME="${SERVICE_NAME:-akapal-geap-ui}"

# --- GEAP agent engine (Vertex AI Agent Engine) -----------------------------
# The deployed supervisor engine this UI talks to. Engine lives in the
# same GCP project (947331501288 = labs-gcp-msls-16495-1782829337) but in
# us-central1 (see deployment_metadata.json), while the Cloud Run service
# itself deploys to REGION above.
export GEAP_ENGINE_ID="${GEAP_ENGINE_ID:-5062056426524901376}"
export GEAP_ENGINE_PROJECT="${GEAP_ENGINE_PROJECT:-${PROJECT_ID}}"
export GEAP_ENGINE_LOCATION="${GEAP_ENGINE_LOCATION:-us-central1}"

# --- E*TRADE ----------------------------------------------------------------
export ETRADE_ENV="${ETRADE_ENV:-sandbox}"
